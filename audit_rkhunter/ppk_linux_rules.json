  "rules": [
    {
      "id": "PPK-1-1",
      "section": "1.1",
      "title": "Запрет пустых паролей",
      "key": "shadow_empty_passwords",
      "expected": "none",
      "command": "awk -F: '($2==\"\") {print $1}' /etc/shadow",
      "risk": "Нет",
      "source": "linux.md; версия 1.1; 11.2025",
      "pilot_required": false
    },
    {
      "id": "PPK-1-2",
      "section": "1.2",
      "title": "Запрет root-входа по SSH",
      "key": "ssh.permitrootlogin",
      "expected": "no",
      "command": "sshd -T | grep -i ^permitrootlogin",
      "risk": "Риск блокировки аварийного доступа; нужен sudo-пользователь",
      "source": "linux.md; версия 1.1; 11.2025",
      "pilot_required": false
    },
    {
      "id": "PPK-1-3",
      "section": "1.3",
      "title": "Ограничение su через pam_wheel",
      "key": "pam.su.wheel",
      "expected": "auth required pam_wheel.so use_uid",
      "command": "grep -n pam_wheel /etc/pam.d/su",
      "risk": "Пользователи вне группы wheel потеряют su",
      "source": "linux.md; версия 1.1; 11.2025",
      "pilot_required": false
    },
    {
      "id": "PPK-1-4",
      "section": "1.4",
      "title": "Проверка конфигурации sudo",
